# Admin connection used by tests to create throwaway databases
TEST_DATABASE_ADMIN_URL=postgres://localhost:5432/postgres

# Auth (every app with an /api) — set ENTRA_TENANT_ID + AUTH_AUDIENCE (production),
# or LOCAL_ADMIN_ENABLED=true (test environments only), or both. At least one is required.
# ENTRA_TENANT_ID=
# AUTH_AUDIENCE=

# Local admin login — off by default, test environments only. Never enable in production;
# Entra remains the only production identity provider. Refused when NODE_ENV=production
# unless LOCAL_ADMIN_ALLOW_IN_PRODUCTION=true.
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_ALLOW_IN_PRODUCTION=false
LOCAL_ADMIN_USERNAME=admin
# Output of `npm run auth:hash-password`
LOCAL_ADMIN_PASSWORD_HASH=
# Shared by every app in one environment so one login works everywhere. At least 32 characters.
LOCAL_AUTH_SECRET=
