{
  "name": "gcpe-news-platform",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:hash-password": "tsx packages/auth/src/cli/hash-password.ts",
    "core:seed-test-users": "npm --workspace @gcpe/core run seed:test-users",
    "nrms:flickr-authorize": "npm --workspace @gcpe/nrms run flickr:authorize",
    "build:siteground": "node scripts/build-siteground.mjs",
    "deploy:siteground": "bash scripts/deploy-siteground.sh",
    "siteground:env": "tsx scripts/siteground-env.ts",
    "core:seed-from-public-api": "tsx scripts/seed-core-from-public-api.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
