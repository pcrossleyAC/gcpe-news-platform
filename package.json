{
  "name": "gcpe-news-platform",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "parity": "tsx tools/parity/capture.ts",
    "parity:urls": "tsx tools/parity/url-check.ts",
    "parity:urls:list": "tsx tools/parity/legacy-url-list.ts",
    "check": "tsc -p tsconfig.json && tsc -p apps/staff-web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:clean-dbs": "tsx scripts/clean-test-dbs.ts",
    "auth:hash-password": "tsx packages/auth/src/cli/hash-password.ts",
    "nod:membership-hash": "tsx scripts/hash-membership-password.ts",
    "core:seed-test-users": "npm --workspace @gcpe/core run seed:test-users",
    "nrms:flickr-authorize": "npm --workspace @gcpe/nrms run flickr:authorize",
    "nrms:import": "npm --workspace @gcpe/nrms run import:legacy --",
    "nrms:import-public-slides": "npm --workspace @gcpe/nrms run import:public-slides --",
    "nod:import": "npm --workspace @gcpe/nod run import:legacy --",
    "nrms:release-holds": "npm --workspace @gcpe/nrms run release-holds --",
    "nrms:replay-to-news-api": "npm --workspace @gcpe/nrms run replay-to-news-api --",
    "nrms:replay-activity-links": "npm --workspace @gcpe/nrms run replay-activity-links --",
    "news-api:search-backfill": "npm --workspace @gcpe/news-api run search-backfill --",
    "news-api:import-public": "npm --workspace @gcpe/news-api run import:public --",
    "news-api:import-files": "npm --workspace @gcpe/news-api run import:files --",
    "legacy-files:copy": "tsx apps/stack/src/legacy-files/cli.ts",
    "calendar:import": "npm --workspace @gcpe/calendar run import:legacy --",
    "calendar:replay-to-nrms": "npm --workspace @gcpe/calendar run replay-to-nrms --",
    "staff-web:build": "node scripts/build-staff-web.mjs",
    "manuals:build": "node scripts/manuals-build.mjs",
    "staff-web:dev": "node scripts/build-staff-web.mjs --watch",
    "build:siteground": "node scripts/build-siteground.mjs",
    "deploy:siteground": "bash scripts/deploy-siteground.sh",
    "build:windows": "node scripts/build-windows.mjs",
    "siteground:env": "tsx scripts/siteground-env.ts",
    "core:seed-from-public-api": "tsx scripts/seed-core-from-public-api.ts",
    "distribution:capacity": "tsx scripts/distribution-capacity.ts",
    "site:rebuild-all": "npm --workspace @gcpe/public-site run site:rebuild-all --",
    "site:precompress": "npm --workspace @gcpe/public-site run site:precompress --",
    "calendar:report-compare": "tsx scripts/calendar-report-compare.ts",
    "calendar:report-parity": "tsx scripts/calendar-report-parity.ts",
    "site:quality": "tsx scripts/site-quality.ts",
    "search:spot-check": "tsx scripts/search-spot-check.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/pngjs": "^6.0.5",
    "chrome-launcher": "1.2.2",
    "docx": "9.15.0",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "lighthouse": "13.5.0",
    "marked": "18.1.2",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
